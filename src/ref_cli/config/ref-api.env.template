# ref-api environment (~/.config/ref/ref-api.env)
#
# Loaded by the user systemd unit created with `ref --install-server`.
# Uncomment and set values as needed.

# YouTube Data API key (optional but recommended for playlist metadata)
# YOUTUBE_API_KEY=

# Bind address and port (defaults match ref-api / install-server)
# REF_API_HOST=0.0.0.0
# REF_API_PORT=8000

# Rumble cookie browser override (see config.yaml)
# REF_RUMBLE_COOKIES_BROWSER=

# YouTube transcript behavior and durable local-transcribe queue.
# remote_first (default) or local_only (never call youtube-transcript-api).
# REF_YOUTUBE_TRANSCRIPT_MODE=remote_first
#
# Absolute paths let the service use pipx-installed lt without changing PATH.
# REF_LOCAL_TRANSCRIBE_LT=/home/you/.local/bin/lt
# REF_LOCAL_TRANSCRIBE_QUEUE_DIR=/path/to/transcription-queue
# REF_LOCAL_TRANSCRIBE_QUEUE_UUID=<queue-uuid>
